{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf-vcs",
  "version": "0.1.0",
  "identifier": "com.pdfvcs.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Version Control",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pdf-vcs-backend"]
  }
}
