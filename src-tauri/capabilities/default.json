{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/pdf-vcs-backend", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "https://www.mongodb.com/cloud/atlas/register" }]
    }
  ]
}
